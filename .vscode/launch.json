      "windows": {"python": "${workspaceFolder}/.venv/Scripts/python.exe"},
      "pythonArgs": ["-B"],
      "args": ["--cifar-feedback-diagnostic", "--run-simulator"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {"PYTHONIOENCODING": "utf-8", "PYTHONUNBUFFERED": "1"}
    },
