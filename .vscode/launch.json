{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Симулятор: все 4 фазы",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/experiment.py",
      "python": "${workspaceFolder}/.venv/bin/python",
      "windows": {
        "python": "${workspaceFolder}/.venv/Scripts/python.exe"
      },
      "pythonArgs": [
        "-B"
      ],
      "args": [
        "--run-simulator"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "PYTHONIOENCODING": "utf-8",
        "PYTHONUNBUFFERED": "1"
      }
    },
    {
      "name": "Аппаратный preflight: без I/O",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/experiment.py",
      "python": "${workspaceFolder}/.venv/bin/python",
      "windows": {
        "python": "${workspaceFolder}/.venv/Scripts/python.exe"
      },
      "pythonArgs": [
        "-B"
      ],
      "args": [
        "--dry-run"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "PYTHONIOENCODING": "utf-8",
        "PYTHONUNBUFFERED": "1"
      }
    }
  ]
}
