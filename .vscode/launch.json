{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "РЎРёРјСѓР»СЏС‚РѕСЂ: РІСЃРµ 4 С„Р°Р·С‹",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/experiment.py",
      "python": "${workspaceFolder}/.venv/bin/python",
      "windows": {
        "python": "${workspaceFolder}/.venv/Scripts/python.exe"
      },
      "pythonArgs": [
        "-B"
      ],
      "args": [
        "--run-simulator"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "PYTHONIOENCODING": "utf-8",
        "PYTHONUNBUFFERED": "1"
      }
    },
    {
      "name": "РђРїРїР°СЂР°С‚РЅС‹Р№ preflight: Р±РµР· I/O",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/experiment.py",
      "python": "${workspaceFolder}/.venv/bin/python",
      "windows": {
        "python": "${workspaceFolder}/.venv/Scripts/python.exe"
      },
      "pythonArgs": [
        "-B"
      ],
      "args": [
        "--dry-run"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "PYTHONIOENCODING": "utf-8",
        "PYTHONUNBUFFERED": "1"
      }
    },
    {
      "name": "Refined интервалы: preflight без I/O",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/experiment.py",
      "python": "${workspaceFolder}/.venv/bin/python",
      "windows": {
        "python": "${workspaceFolder}/.venv/Scripts/python.exe"
      },
      "pythonArgs": [
        "-B"
      ],
      "args": [
        "--test-cell-ranges-refined",
