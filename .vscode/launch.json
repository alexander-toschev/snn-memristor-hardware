{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "CIFAR v1: preflight платы без I/O",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/experiment.py",
      "python": "${workspaceFolder}/.venv/bin/python",
      "windows": {"python": "${workspaceFolder}/.venv/Scripts/python.exe"},
      "pythonArgs": ["-B"],
      "args": ["--cifar-feedback-diagnostic", "--dry-run"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {"PYTHONIOENCODING": "utf-8", "PYTHONUNBUFFERED": "1"}
    },
    {
      "name": "CIFAR v1: полный диагностический simulator",
      "type": "debugpy",
      "request": "launch",
