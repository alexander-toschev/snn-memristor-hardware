#!/bin/sh
set -eu
if command -v gitleaks >/dev/null 2>&1; then
    scanner=gitleaks
elif [ -x .tools/gitleaks.exe ]; then
    scanner=.tools/gitleaks.exe
else
    echo "Commit blocked: install Gitleaks on PATH or in .tools (see SECURITY.md)." >&2
    exit 1
fi
exec "$scanner" git --staged --redact=100 --no-banner --ignore-gitleaks-allow
