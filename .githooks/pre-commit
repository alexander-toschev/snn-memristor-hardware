#!/bin/sh
set -eu
if command -v gitleaks >/dev/null 2>&1; then
    scanner=gitleaks
elif [ -x .tools/gitleaks.exe ]; then
    scanner=.tools/gitleaks.exe
elif [ -x .tools/gitleaks ]; then
    scanner=.tools/gitleaks
else
    echo "Commit blocked: install Gitleaks on PATH or in .tools (see SECURITY.md)." >&2
    exit 1
fi
"$scanner" git --staged --redact=100 --no-banner --ignore-gitleaks-allow
python=
for candidate in .venv/bin/python .venv/Scripts/python.exe python3 python; do
    if [ -x "$candidate" ] || command -v "$candidate" >/dev/null 2>&1; then
        # A Windows Store alias may exist on PATH without a working Python.
        # Probe execution and supported version, not just command presence.
        if "$candidate" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 8) else 1)' >/dev/null 2>&1; then
            python=$candidate
            break
        fi
    fi
done
if [ -z "$python" ]; then
    echo "Commit blocked: a working Python 3.8+ is required for staged LFS payload scanning." >&2
    exit 1
fi
exec "$python" -B tools/security/scan_staged_lfs.py
